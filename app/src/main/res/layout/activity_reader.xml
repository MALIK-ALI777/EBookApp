<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ebook_bg"
    android:orientation="vertical"
    tools:context=".ReaderActivity">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/ebook_white"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:clickable="true"
            android:contentDescription="Back"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:id="@+id/tvReaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Clean Code"
            android:textColor="@color/ebook_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnFontMinus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="A-"
            android:textColor="@color/ebook_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnFontPlus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_chip"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="A+"
            android:textColor="@color/ebook_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnNight"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:clickable="true"
            android:contentDescription="Night mode"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_night" />
    </LinearLayout>

    <!-- Reading area -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/tvReaderText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="6dp"
            android:padding="20dp"
            android:text="Chapter 1: Getting Started&#10;&#10;Every great journey begins with a single step, and every good book begins with a single page. This is a sample chapter used to design the reader screen. In the next labs, the real text of each book will be loaded here from a file.&#10;&#10;Reading on a phone should be comfortable. That is why this screen has adjustable text size, a night mode button for reading in the dark, and simple Previous and Next buttons to move between pages.&#10;&#10;A good reader screen keeps things simple. The text takes most of the space, the controls stay out of the way, and the reader always knows which page they are on. Scroll down to test how a long chapter looks on the screen.&#10;&#10;Lorem ipsum style filler is boring, so here is a little more sample content. Software is built in layers. First you design the screens, then you connect them with code, then you add the features, and finally you store the data. That is exactly how this project is organised across four labs.&#10;&#10;The more you read, the more you learn. Keep going, one page at a time."
            android:textColor="@color/ebook_text"
            android:textSize="18sp" />
    </ScrollView>

    <!-- Bottom bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/ebook_white"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <Button
            android:id="@+id/btnPrev"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/ebook_primary"
            android:text="Prev"
            android:textColor="@color/ebook_white" />

        <TextView
            android:id="@+id/tvPage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Page 1 of 12"
            android:textColor="@color/ebook_text_secondary"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnNext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/ebook_primary"
            android:text="Next"
            android:textColor="@color/ebook_white" />
    </LinearLayout>
</LinearLayout>
